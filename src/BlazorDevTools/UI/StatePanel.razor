@namespace BlazorDevTools.UI
@inherits DevToolsTab

<div class="bdt-split">
    <div class="bdt-left" style="flex-basis:30%">
        <div class="bdt-toolbar"><strong>State providers</strong> <span class="bdt-muted">(@_entries.Length)</span></div>
        <div class="bdt-scroll">
            @if (_entries.Length == 0)
            {
                <div class="bdt-empty">
                    No state providers registered. Implement <code>IStateProvider</code> on your state container and register it
                    (<code>services.AddDevToolsStateProvider&lt;T&gt;()</code>), or adapt an existing service with
                    <code>AddDevToolsStateProvider&lt;TService&gt;(name, snapshot, subscribe)</code>. For a long-lived custom
                    subscription, use <code>AddDevToolsStateProviderWithSubscription</code> so it is disposed with the scope.
                    Component state is inspected per component in the Components panel.
                </div>
            }
            @foreach (var item in _entries)
            {
                var name = item.Name;
                <div class="bdt-ev-row @(Ui.SelectedStateProvider == name ? "bdt-selected" : "")" @onclick="() => { Ui.SelectedStateProvider = name; _selectedChange = null; Ui.Touch(); }">
                    <span class="bdt-ev-title bdt-mono">@item.Name</span>
                    <span class="bdt-chip">@item.Origin</span>
                    <span class="bdt-ev-dur">@item.ChangeCount Δ</span>
                </div>
            }
        </div>
    </div>
    <div class="bdt-right">
        @if (_selected is { } entry)
        {
            <div class="bdt-section">
                <div class="bdt-section-title">Current snapshot <span class="bdt-muted" style="font-weight:normal">@entry.Description · last change @Fmt.Ago(entry.LastChangedAt)</span></div>
                <div class="bdt-section-body">
                    @if (entry.Error is not null)
                    {
                        <div class="bdt-chip bdt-err">@entry.Error</div>
                    }
                    <ValueTree Root="_snapshot" Name="@entry.Name" Inspector="Session.Inspector" ChildrenOnly="true" />
                </div>
            </div>
            <div class="bdt-section">
                <div class="bdt-section-title">Change history (@entry.ChangeCount) <span class="bdt-muted" style="font-weight:normal">newest first · click to see before/after</span></div>
                <div class="bdt-section-body">
                    @foreach (var change in entry.Changes.Reverse())
                    {
                        var c = change;
                        <div class="bdt-ev-row @(_selectedChange?.Id == c.Id ? "bdt-selected" : "")" @onclick="() => _selectedChange = c">
                            <span class="bdt-time">@Fmt.Time(c.At)</span>
                            <span class="bdt-ev-title">@(c.Action ?? "changed") <span class="bdt-muted">@c.Changes.Count member@(c.Changes.Count == 1 ? "" : "s")</span> @if (c.TriggerEventId is { } t) { <button type="button" class="bdt-link" @onclick:stopPropagation="true" @onclick="() => Host.SelectEvent(t)">trigger ↗</button> }</span>
                        </div>
                    }
                </div>
            </div>
            @if (_selectedChange is { } sc)
            {
                <div class="bdt-section">
                    <div class="bdt-section-title">Diff @Fmt.Time(sc.At) @(sc.Action) <button type="button" class="bdt-link" style="margin-left:auto;font-weight:normal" @onclick="() => Host.SelectEvent(sc.TimelineEventId)">timeline ↗</button></div>
                    <div class="bdt-section-body">
                        @if (sc.Changes.Count == 0)
                        {
                            <div class="bdt-muted">No observable member changed (the object may have changed a private field or a member beyond the inspection depth).</div>
                        }
                        else
                        {
                            <table>
                                <thead><tr><th>Member</th><th>Before</th><th>After</th></tr></thead>
                                <tbody>
                                    @foreach (var d in sc.Changes)
                                    {
                                        <tr><td class="bdt-mono">@d.Path</td><td class="bdt-mono bdt-muted">@(d.Before ?? "∅")</td><td class="bdt-mono">@(d.After ?? "∅")</td></tr>
                                    }
                                </tbody>
                            </table>
                        }
                        <details style="margin-top:6px">
                            <summary class="bdt-muted">Snapshot at that point (@sc.Snapshot.Count entries)</summary>
                            <table>
                                <tbody>
                                    @foreach (var kv in sc.Snapshot.OrderBy(k => k.Key))
                                    {
                                        <tr><td class="bdt-mono">@kv.Key</td><td class="bdt-mono">@kv.Value</td></tr>
                                    }
                                </tbody>
                            </table>
                        </details>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="bdt-empty">Select a provider.</div>
        }
    </div>
</div>

@code {
    private StateProviderEntry[] _entries = [];
    private StateProviderEntry? _selected;
    private object? _snapshot;
    private StateChangeRecord? _selectedChange;

    protected override void OnParametersSet()
    {
        _entries = Session.State.Entries;
        Ui.SelectedStateProvider ??= _entries.FirstOrDefault()?.Name;
        _selected = _entries.FirstOrDefault(e => e.Name == Ui.SelectedStateProvider);
        if (_selectedChange is not null && (_selected is null || !_selected.Changes.Any(change => change.Id == _selectedChange.Id)))
        {
            _selectedChange = null;
        }

        try
        {
            _snapshot = _selected?.Provider.GetSnapshot();
        }
        catch (Exception ex)
        {
            _snapshot = "«GetSnapshot threw " + ex.GetType().Name + ": " + ex.Message + "»";
        }
    }
}
