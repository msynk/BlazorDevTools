@namespace BlazorDevTools.UI

<div class="bdt-vt">
    @Render((Node, 0))
</div>

@code {
    [Parameter, EditorRequired] public object? Root { get; set; }

    [Parameter] public string Name { get; set; } = "value";

    [Parameter, EditorRequired] public ObjectInspector Inspector { get; set; } = default!;

    /// <summary>When set, the root node itself is hidden and only its children are shown.</summary>
    [Parameter] public bool ChildrenOnly { get; set; }

    [Parameter] public System.Reflection.MemberInfo? Member { get; set; }

    private readonly HashSet<string> _expanded = new(StringComparer.Ordinal);
    private object? _lastRoot;

    private InspectedNode Node => Inspector.Describe(Name, Root, "", Member);

    protected override void OnParametersSet()
    {
        if (!ReferenceEquals(_lastRoot, Root))
        {
            _lastRoot = Root;
            _expanded.Clear();
            if (ChildrenOnly)
            {
                _expanded.Add("");
            }
        }
    }

    private RenderFragment<(InspectedNode Node, int Depth)> Render => ctx => __builder =>
    {
        var (node, depth) = ctx;
        var open = _expanded.Contains(node.Path);
        if (!(ChildrenOnly && depth == 0))
        {
            <div class="bdt-vt-row" style="padding-left:@(depth * 14)px" title="@node.TypeName">
                @if (node.IsExpandable)
                {
                    <span class="bdt-caret" @onclick="() => Toggle(node.Path)">@(open ? "▾" : "▸")</span>
                }
                else
                {
                    <span class="bdt-caret"></span>
                }
                <span class="bdt-vt-name">@node.Name:</span>
                <span class="bdt-vt-value bdt-k-@node.Kind.ToString().ToLowerInvariant()">@node.Display</span>
                @if (node.TypeName is not null && node.Kind is NodeKind.Object or NodeKind.Collection or NodeKind.Dictionary)
                {
                    <span class="bdt-vt-type">@node.TypeName</span>
                }
            </div>
        }
        if (open && node.IsExpandable)
        {
            foreach (var child in Inspector.Children(Root, node.Path))
            {
                @Render((child, ChildrenOnly ? depth : depth + 1))
            }
        }
    };

    private void Toggle(string path)
    {
        if (!_expanded.Remove(path))
        {
            _expanded.Add(path);
        }
    }
}
