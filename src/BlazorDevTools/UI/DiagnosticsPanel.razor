@namespace BlazorDevTools.UI
@inherits DevToolsTab

<div class="bdt-split">
    <div class="bdt-left" style="flex-basis:64%">
        <div class="bdt-toolbar">
            <strong>Findings</strong>
            <span class="bdt-muted">@_active.Count active · @_dismissed dismissed</span>
            <span style="margin-left:auto"></span>
            <label><input type="checkbox" checked="@_showDismissed" @onchange='e => { _showDismissed = e.Value is true; OnParametersSet(); }' /> show dismissed</label>
            <button type="button" @onclick="() => Session.Diagnostics.Evaluate(force: true)">Re-run</button>
            <button type="button" @onclick="() => Session.Diagnostics.Clear()">Clear</button>
        </div>
        <div class="bdt-scroll">
            @if (_active.Count == 0)
            {
                <div class="bdt-empty">No findings. Rules run every second on recent activity and only report evidence-backed patterns (render storms, cascades, slow renders, duplicate requests, slow interop, repeated errors, DI lifetime problems).</div>
            }
            @foreach (var f in _active)
            {
                var d = f.Diagnostic;
                <div class="bdt-diag" style="@(f.Dismissed ? "opacity:.5" : "")">
                    <div class="bdt-diag-title">
                        <span class="bdt-sev-dot bdt-@d.Severity.ToString().ToLowerInvariant()"></span>
                        @d.Title
                        <span class="bdt-chip">@d.RuleId</span>
                        <span class="bdt-muted">first seen @Fmt.Ago(f.FirstSeen) · still reported @Fmt.Ago(f.LastSeen)</span>
                    </div>
                    <div class="bdt-diag-evidence">@d.Evidence</div>
                    @if (d.Suggestion is not null)
                    {
                        <div class="bdt-diag-suggestion">💡 @d.Suggestion</div>
                    }
                    <div class="bdt-diag-actions">
                        @if (d.ComponentInstanceId is { } cid)
                        {
                            <button type="button" @onclick="() => Host.SelectComponent(cid)">Component ↗</button>
                        }
                        @if (d.RelatedEventIds is { Count: > 0 } related)
                        {
                            <button type="button" @onclick="() => Host.SelectEvent(related[0])">Events ↗</button>
                        }
                        @if (d.RuleId.StartsWith("di.", StringComparison.Ordinal))
                        {
                            <button type="button" @onclick='() => Host.ShowPanel("services")'>Services ↗</button>
                        }
                        <button type="button" @onclick="() => Host.SelectEvent(f.TimelineEventId)">Timeline ↗</button>
                        @if (!f.Dismissed)
                        {
                            <button type="button" @onclick="() => Session.Diagnostics.Dismiss(d.EffectiveFingerprint)">Dismiss</button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="bdt-right">
        <div class="bdt-section">
            <div class="bdt-section-title">Rules (@Session.Diagnostics.Rules.Count)</div>
            <div class="bdt-section-body">
                <table>
                    <thead><tr><th>Id</th><th>Rule</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var rule in Session.Diagnostics.Rules)
                        {
                            var disabled = Session.Options.Diagnostics.DisabledRules.Contains(rule.Id);
                            <tr><td class="bdt-mono">@rule.Id</td><td><strong>@rule.Title</strong><div class="bdt-muted">@rule.Description</div></td><td>@if (disabled) { <span class="bdt-chip bdt-warn">disabled</span> }</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="bdt-section">
            <div class="bdt-section-title">Thresholds</div>
            <div class="bdt-section-body">
                @{ var o = Session.Options.Diagnostics; }
                <dl class="bdt-kv">
                    <dt>Render storm</dt><dd>≥ @o.RenderStormCount renders in @o.RenderStormWindowMs ms</dd>
                    <dt>Render cascade</dt><dd>≥ @o.RenderCascadeSize components in one batch</dd>
                    <dt>Slow render</dt><dd>≥ @o.SlowRenderMs ms</dd>
                    <dt>Slow event handler</dt><dd>≥ @o.SlowEventHandlerMs ms</dd>
                    <dt>Duplicate HTTP</dt><dd>≥ @o.DuplicateHttpCount identical in @o.DuplicateHttpWindowMs ms</dd>
                    <dt>Slow HTTP</dt><dd>≥ @o.SlowHttpMs ms</dd>
                    <dt>Slow JS interop</dt><dd>≥ @o.SlowJsInteropMs ms</dd>
                    <dt>Excessive JS interop</dt><dd>≥ @o.ExcessiveJsInteropCount calls/s to one identifier</dd>
                    <dt>Repeated error</dt><dd>≥ @o.RepeatedErrorCount occurrences</dd>
                </dl>
                <div class="bdt-muted">Configure in <code>AddBlazorDevTools(o =&gt; o.Diagnostics…)</code>.</div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<DiagnosticRecord> _active = [];
    private int _dismissed;
    private bool _showDismissed;

    protected override void OnParametersSet()
    {
        var all = Session.Diagnostics.Findings;
        _dismissed = all.Count(f => f.Dismissed);
        _active = all.Where(f => _showDismissed || !f.Dismissed).ToList();
    }
}
