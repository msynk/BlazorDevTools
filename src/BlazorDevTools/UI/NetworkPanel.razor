@namespace BlazorDevTools.UI

<div class="bdt-split">
    <div class="bdt-left" style="flex-basis:58%">
        <div class="bdt-toolbar">
            <input type="text" placeholder='Filter: url text, method:GET, status:failed|pending|2xx|4xx|5xx' value="@Query" @oninput="OnQuery" />
            <button type="button" @onclick="() => Session.Http.Clear()">Clear</button>
            <span class="bdt-muted bdt-nowrap">@_rows.Count / @_all.Length · @Session.Http.FailedCount failed</span>
        </div>
        <div class="bdt-scroll">
            @if (_rows.Count == 0)
            {
                <div class="bdt-empty">No HTTP requests captured. Requests made through IHttpClientFactory clients are tracked automatically; hand-built HttpClient instances need <code>DevToolsHttpMessageHandler</code>.</div>
            }
            else
            {
                <table>
                    <thead><tr><th>Time</th><th>Method</th><th>URL</th><th class="bdt-num">Status</th><th class="bdt-num">Duration</th><th class="bdt-num">Size</th><th>Trigger</th></tr></thead>
                    <tbody>
                        <Virtualize Items="_rows" ItemSize="23" Context="r" SpacerElement="tr">
                            <tr class="bdt-row @(Ui.SelectedHttpId == r.Id ? "bdt-selected" : "") @(r.IsFailed ? "bdt-sev-error" : "")" @onclick="() => { Ui.SelectedHttpId = r.Id; Ui.Touch(); }">
                                <td class="bdt-mono">@Fmt.Time(r.StartedAt)</td>
                                <td class="bdt-mono">@r.Method</td>
                                <td class="bdt-mono bdt-truncate" style="max-width:320px" title="@r.Url">@Instrumentation.DevToolsHttpMessageHandler.StripOrigin(r.Url)</td>
                                <td class="bdt-num @(r.IsFailed ? "bdt-err" : "")">@(r.Error is not null ? "ERR" : r.StatusCode?.ToString() ?? "…")</td>
                                <td class="bdt-num">@(r.IsPending ? "pending" : Fmt.Ms(r.DurationMs))</td>
                                <td class="bdt-num">@Fmt.Bytes(r.ResponseBytes)</td>
                                <td class="bdt-truncate bdt-muted" style="max-width:180px" title="@r.TriggerDescription">@(r.TriggerDescription ?? "–")</td>
                            </tr>
                        </Virtualize>
                    </tbody>
                </table>
            }
        </div>
    </div>
    <div class="bdt-right">
        @if (_selected is { } s)
        {
            <div class="bdt-section">
                <div class="bdt-section-title bdt-mono">@s.Method @Instrumentation.DevToolsHttpMessageHandler.StripOrigin(s.Url)</div>
                <div class="bdt-section-body">
                    <dl class="bdt-kv">
                        <dt>URL</dt><dd class="bdt-mono">@s.Url</dd>
                        <dt>Status</dt><dd>@(s.Error ?? (s.StatusCode is null ? "pending" : s.StatusCode + " " + s.ReasonPhrase))</dd>
                        <dt>Started</dt><dd>@Fmt.Time(s.StartedAt)</dd>
                        <dt>Duration</dt><dd>@Fmt.Ms(s.DurationMs)</dd>
                        <dt>Request size</dt><dd>@Fmt.Bytes(s.RequestBytes)</dd>
                        <dt>Response size</dt><dd>@Fmt.Bytes(s.ResponseBytes) @(s.ContentType is null ? "" : "· " + s.ContentType)</dd>
                        <dt>Trigger</dt><dd>@if (s.TriggerEventId is { } t) { <button type="button" class="bdt-link" @onclick="() => Host.SelectEvent(t)">@s.TriggerDescription ↗</button> } else { <span class="bdt-muted">not inside a UI event (lifecycle method, timer or background work)</span> }</dd>
                        <dt>Timeline</dt><dd><button type="button" class="bdt-link" @onclick="() => Host.SelectEvent(s.TimelineEventId)">open event ↗</button></dd>
                    </dl>
                    <div class="bdt-muted" style="margin-top:4px">Bodies are never captured. Sensitive headers and query values are redacted.</div>
                </div>
            </div>
            @if (s.RequestHeaders is { Count: > 0 })
            {
                <div class="bdt-section">
                    <div class="bdt-section-title">Request headers (@s.RequestHeaders.Count)</div>
                    <div class="bdt-section-body"><table><tbody>@foreach (var h in s.RequestHeaders) { <tr><td class="bdt-mono">@h.Key</td><td class="bdt-mono">@h.Value</td></tr> }</tbody></table></div>
                </div>
            }
            @if (s.ResponseHeaders is { Count: > 0 })
            {
                <div class="bdt-section">
                    <div class="bdt-section-title">Response headers (@s.ResponseHeaders.Count)</div>
                    <div class="bdt-section-body"><table><tbody>@foreach (var h in s.ResponseHeaders) { <tr><td class="bdt-mono">@h.Key</td><td class="bdt-mono">@h.Value</td></tr> }</tbody></table></div>
                </div>
            }
            @if (_duplicates > 1)
            {
                <div class="bdt-section"><div class="bdt-section-body"><span class="bdt-chip bdt-warn">This exact request appears @_duplicates times in the buffer.</span></div></div>
            }
        }
        else
        {
            <div class="bdt-empty">Select a request.</div>
        }
    </div>
</div>

@code {
    [CascadingParameter] public DevToolsPanel Host { get; set; } = default!;

    private DevToolsSession Session => Host.Session;

    private DevToolsUiState Ui => Host.Ui;

    private string? Query => Ui.GetQuery("network");

    private HttpRecord[] _all = [];
    private List<HttpRecord> _rows = [];
    private HttpRecord? _selected;
    private int _duplicates;

    protected override void OnParametersSet()
    {
        _all = Session.Http.Snapshot();
        var filter = QueryFilter.Parse(Query);
        var status = filter.Token("status");
        var method = filter.Token("method");
        _rows = _all.Reverse().Where(r =>
            filter.MatchesText(r.Url, r.Method, r.TriggerDescription, r.Error)
            && (method is null || r.Method.Equals(method, StringComparison.OrdinalIgnoreCase))
            && (status is null || status.ToLowerInvariant() switch
            {
                "failed" => r.IsFailed,
                "pending" => r.IsPending,
                "2xx" => r.StatusCode is >= 200 and < 300,
                "3xx" => r.StatusCode is >= 300 and < 400,
                "4xx" => r.StatusCode is >= 400 and < 500,
                "5xx" => r.StatusCode is >= 500,
                var code => r.StatusCode?.ToString() == code,
            })).ToList();
        _selected = Ui.SelectedHttpId is { } id ? Session.Http.Find(id) : null;
        _duplicates = _selected is null ? 0 : _all.Count(r => r.Signature == _selected.Signature);
    }

    private void OnQuery(ChangeEventArgs e) => Ui.SetQuery("network", e.Value?.ToString());
}
